# Copier en `.env`, jamais versionné, puis renseigner les valeurs.

# Claude : la clé d'API est indispensable ; sans modèle renseigné, claude-haiku-5-5.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Odoo : paramètres de l'envoi des commandes, lus par aucun code aujourd'hui (envoi jamais exécuté).
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
